# Generated on each deploy as secrets.env (GitHub Actions → VPS). Do not commit.

LATENESS_IMAGE=ghcr.io/OWNER/lateness@sha256:…

LATENESS_DATABASE_URL=postgres://lateness:CHANGE_ME@postgres:5432/lateness?sslmode=disable
# openssl rand -base64 32. Never change it after outlets are saved: they become unreadable.
LATENESS_SECRET_KEY=

# VK ID: redirect https://<domain>/auth/vk/callback
# LATENESS_VK_CLIENT_ID=
# LATENESS_VK_CLIENT_SECRET=
# Telegram Login (OIDC, @BotFather): redirect https://<domain>/auth/telegram/callback
# LATENESS_TELEGRAM_LOGIN_CLIENT_ID=
# LATENESS_TELEGRAM_LOGIN_CLIENT_SECRET=
# Bot API reverse proxy for Telegram outlets, without a trailing slash.
# LATENESS_TELEGRAM_API_URL=https://tg-proxy.example.com
