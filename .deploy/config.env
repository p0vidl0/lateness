# Non-secret deploy config (committed). Secrets: secrets.env, written by GitHub Actions.
# Edit LATENESS_DOMAIN before the first deploy.

LATENESS_DOMAIN=lateness.example.com
LATENESS_PUBLIC_URL=https://lateness.example.com

TRAEFIK_NETWORK=web
TRAEFIK_CERT_RESOLVER=myresolver

LATENESS_HTTP_ADDR=:8080
LATENESS_SWEEP_INTERVAL=15s
LATENESS_SESSION_TTL=720h

# Production safety: probes may not reach private networks, SMTP certificates are verified.
LATENESS_PROBE_ALLOW_PRIVATE=0
LATENESS_SMTP_INSECURE_TLS=0

# Empty = https://api.telegram.org. A reverse proxy goes into the secret LATENESS_TELEGRAM_API_URL.
